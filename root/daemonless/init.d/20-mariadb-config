#!/bin/sh
# MariaDB configuration setup

MYSQL_DIR="${MYSQL_DIR:-/config}"
DATADIR="${DATADIR:-$MYSQL_DIR/databases}"

echo "Setting up MariaDB..."

# Create required directories
mkdir -p "$DATADIR" "$MYSQL_DIR/log/mysql" /var/run/mysql

# custom.cnf is the supported way to pass server options: a compose `command:`
# replaces the image's CMD (/daemonless/libexec/mariadb, which sets up and
# starts the server), so don't use one.  Created here rather than at first-init so datadirs
# that predate this file get one too -- the server refuses to start if
# --defaults-extra-file names a file that is not there.
#
# A new datadir defaults to utf8mb4, as MariaDB on Linux does (Debian's
# packaging; 11.6+ upstream). The FreeBSD packages before 11.6 default to
# latin1, and apps written against utf8mb4 break on it: uptime-kuma's
# migration fails with "Row size too large" on 11.4. An existing datadir keeps
# the charset its tables were made with.
if [ ! -f "$MYSQL_DIR/custom.cnf" ]; then
    if [ -d "$DATADIR/mysql" ]; then
        charset="#   character-set-server = utf8mb4"
    else
        charset="character-set-server = utf8mb4"
    fi
    cat > "$MYSQL_DIR/custom.cnf" << EOF
[mysqld]
# Custom MariaDB configuration -- loaded on every start.
$charset
# Add your settings here, e.g.:
#   collation-server     = utf8mb4_unicode_ci
#   innodb_buffer_pool_size = 512M
EOF
fi

# Set ownership (bsd:bsd is UID/GID 1000:1000)
chown -R bsd:bsd "$MYSQL_DIR" /var/run/mysql
# MariaDB ignores an option file that is group- or world-writable.
chmod 644 "$MYSQL_DIR/custom.cnf"

echo "MariaDB configuration complete"
